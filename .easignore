# If EAS packages from the repository root, exclude everything unrelated to the mobile app.
# Web/API folders are anchored with a leading "/" so they only match at the repo root:
# an unanchored "app/" or "lib/" would also strip the mobile app's own "app/" routes and
# "src/lib/", producing an APK that crashes on launch with "No routes found".
.git/
/.next/
/api/
/app/
/components/
/lib/
/locales/
/public/
/types/
.claude/
node_modules/
*.log
tsconfig.tsbuildinfo

# Exclude mobile build artifacts regardless of whether paths are resolved
# from the repo root or the mobile project root.
.expo/
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
expo-mobile.log
expo-mobile.err.log
metro.log

ArX Task mobile/node_modules/
ArX Task mobile/.expo/
ArX Task mobile/android/.gradle/
ArX Task mobile/android/build/
ArX Task mobile/android/app/build/
ArX Task mobile/android/app/.cxx/
ArX Task mobile/expo-mobile.log
ArX Task mobile/expo-mobile.err.log
ArX Task mobile/metro.log
